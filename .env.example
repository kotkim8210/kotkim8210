ANTHROPIC_API_KEY=sk-ant-...

# Optional: override the default model
# MODEL=claude-sonnet-4-6

# Optional: skip Puppeteer Chromium download and use system Chrome
# PUPPETEER_SKIP_DOWNLOAD=true
# PUPPETEER_EXECUTABLE_PATH=/usr/bin/google-chrome

# Account handle shown in cards
DEFAULT_HANDLE=@알쓸지잡10

# === Instagram Carousel 자동 업로드 (선택) ===
# imgbb.com 무료 가입 후 발급
IMGBB_API_KEY=

# Instagram Graph API
# - IG_ACCESS_TOKEN: 60일 long-lived user access token (docs/instagram-setup.md 참고)
# - IG_USER_ID: Instagram Business Account ID (숫자, 17자리 정도)
IG_ACCESS_TOKEN=
IG_USER_ID=

# === Google Sheets 연동 (선택) ===
# docs/sheets-setup.md 참고
# - GOOGLE_SHEETS_ID: 시트 URL의 /d/ 와 /edit 사이 ID
# - GOOGLE_SERVICE_ACCOUNT_JSON: service account JSON 파일 경로
GOOGLE_SHEETS_ID=
GOOGLE_SERVICE_ACCOUNT_JSON=./credentials/service-account.json

# === 안전 발행 고급 옵션 (선택) ===
# 실패/토큰경고 알림 웹훅 (Slack 또는 Discord incoming webhook URL)
WEBHOOK_URL=
# true 로 두면 토큰 만료 14일 전 발행 시 자동 갱신 + .env 반영
AUTO_REFRESH_TOKEN=
# FB Login 계열 토큰 갱신(fb_exchange_token)·만료조회에 사용 (Meta 앱 Settings→Basic)
FB_APP_ID=
FB_APP_SECRET=
