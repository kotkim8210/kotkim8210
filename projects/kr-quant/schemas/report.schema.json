{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kr-quant.local/schemas/report.schema.json",
  "title": "KR-Quant 종목 분석 리포트 (기계 판독용)",
  "description": "krq deepdive 산출물. 같은 payload에서 마크다운 리포트가 렌더링되므로 두 형태의 내용은 항상 일치한다.",
  "type": "object",
  "required": ["meta", "stock", "scores", "gates", "signal", "rationale", "risks"],
  "additionalProperties": false,
  "properties": {
    "meta": {
      "type": "object",
      "required": ["schema_version", "as_of", "config_hash", "rules_version", "generated_at"],
      "properties": {
        "schema_version": { "type": "string", "const": "1.0" },
        "as_of": { "type": "string", "format": "date" },
        "config_hash": { "type": "string" },
        "rules_version": { "type": "string" },
        "generated_at": { "type": "string", "format": "date-time" }
      }
    },

    "stock": {
      "type": "object",
      "required": ["code", "name", "sector", "market_cap"],
      "properties": {
        "code": { "type": "string", "pattern": "^[0-9A-Z]{6}$" },
        "name": { "type": "string" },
        "market": { "enum": ["KOSPI", "KOSDAQ"] },
        "sector": { "type": "string" },
        "ksic": { "type": "string" },
        "market_cap": { "type": "number", "minimum": 0 },
        "listing_date": { "type": "string", "format": "date" },
        "shares_outstanding": { "type": "number" }
      }
    },

    "scores": {
      "type": "object",
      "required": ["total", "grade", "confidence", "data_coverage", "axes"],
      "properties": {
        "total": { "type": "number", "minimum": 0, "maximum": 100 },
        "grade": { "enum": ["S", "A", "B", "C", "D"] },
        "confidence": {
          "type": "number", "minimum": 0, "maximum": 100,
          "description": "TOTAL과 별개. '얼마나 좋은가'가 아니라 '이 판단을 얼마나 믿을 수 있는가'."
        },
        "data_coverage": { "type": "number", "minimum": 0, "maximum": 1 },
        "axes": {
          "type": "object",
          "required": ["F", "D", "S", "T", "E", "Q", "C"],
          "additionalProperties": false,
          "patternProperties": {
            "^[FDSTEQC]$": {
              "type": "object",
              "required": ["value", "coverage"],
              "properties": {
                "value": {
                  "type": ["number", "null"], "minimum": 0, "maximum": 100,
                  "description": "판정 불가 시 null. 0으로 대체하지 않는다 (INV-5)."
                },
                "coverage": { "type": "number", "minimum": 0, "maximum": 1 },
                "components": {
                  "type": "object",
                  "additionalProperties": { "type": ["number", "null"] },
                  "description": "하위지표별 점수. 사후 재현을 위한 감사추적 (INV-4)."
                }
              }
            }
          }
        }
      }
    },

    "gates": {
      "type": "object",
      "required": ["hard", "quad_gate", "overheat_veto"],
      "properties": {
        "hard": {
          "type": "object",
          "properties": {
            "passed": { "type": "boolean" },
            "violations": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "id": { "type": "string", "pattern": "^G[0-9]$" },
                  "name": { "type": "string" },
                  "detail": { "type": "string" }
                }
              }
            }
          }
        },
        "soft": {
          "type": "object",
          "properties": {
            "penalties": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "id": { "type": "string" },
                  "total_penalty": { "type": "number" },
                  "size_multiplier": { "type": "number" }
                }
              }
            },
            "size_multiplier": { "type": "number", "minimum": 0, "maximum": 1 }
          }
        },
        "quad_gate": {
          "type": "object",
          "description": "4중 동시충족 게이트 — 재무/공시/(수급·기술)/역발상",
          "required": ["fundamental", "disclosure", "flow_or_technical", "contrarian", "passed"],
          "properties": {
            "fundamental": { "type": "boolean" },
            "disclosure": { "type": "boolean" },
            "flow_or_technical": { "type": "boolean" },
            "contrarian": { "type": "boolean" },
            "total_threshold": { "type": "boolean" },
            "passed": { "type": "boolean" }
          }
        },
        "overheat_veto": {
          "type": "object",
          "description": "과열 거부권. count>=3 이면 TOTAL 점수와 무관하게 신규 매수 금지.",
          "required": ["count", "triggered", "blocked"],
          "properties": {
            "count": { "type": "integer", "minimum": 0, "maximum": 5 },
            "triggered": {
              "type": "array",
              "items": { "type": "string", "pattern": "^V[1-5]$" }
            },
            "blocked": { "type": "boolean" },
            "size_multiplier": { "type": "number" }
          }
        }
      }
    },

    "scenario": {
      "type": "object",
      "description": "시나리오 트랙 (§10~11). active=false면 나머지 필드는 null.",
      "required": ["active"],
      "properties": {
        "active": { "type": "boolean" },
        "scenario_id": { "type": ["string", "null"] },
        "title": { "type": ["string", "null"] },
        "catalyst_type": {
          "enum": ["policy", "regulation", "budget", "corporate", null]
        },
        "announced_at": { "type": ["string", "null"], "format": "date" },
        "lifecycle_stage": {
          "enum": ["proposed", "passed", "promulgated", "effective",
                   "budgeted", "contracted", null]
        },
        "tracking_phase": {
          "type": ["integer", "null"], "minimum": 1, "maximum": 4,
          "description": "4단계 추적 모델: 1=이벤트발생 2=기대형성 3=실적/수급반응 4=중기재평가"
        },
        "state": {
          "enum": ["WATCH", "CONFIRM_PENDING", "SCALE_IN", "SCALE_UP", "LAPSED", "EXIT", null]
        },
        "buy_allowed": { "type": ["boolean", "null"] },
        "link_strength": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
        "link_basis": {
          "type": ["string", "null"],
          "description": "연결 근거 텍스트. DQ-09가 비어있지 않음을 강제한다."
        },
        "verified_by": { "enum": ["auto", "auto_low", "human", null] },
        "confirmations": {
          "type": "object",
          "properties": {
            "earnings": { "type": "boolean" },
            "flow": { "type": "boolean" },
            "chart": { "type": "boolean" },
            "disclosure": { "type": "boolean" },
            "count": { "type": "integer", "minimum": 0, "maximum": 4 }
          }
        }
      }
    },

    "signal": {
      "type": "object",
      "required": ["action", "triggered_rules", "blocked_by"],
      "properties": {
        "action": {
          "enum": ["BUY_CANDIDATE", "HOLD", "TRIM", "EXIT", "NO_NEW_BUY", "SKIP"]
        },
        "track": { "enum": ["value", "scenario", null] },
        "size_pct": { "type": ["number", "null"], "minimum": 0, "maximum": 10 },
        "tranche": { "type": ["integer", "null"], "minimum": 1, "maximum": 3 },
        "triggered_rules": { "type": "array", "items": { "type": "string" } },
        "blocked_by": { "type": "array", "items": { "type": "string" } },
        "warnings": { "type": "array", "items": { "type": "string" } },
        "entry_plan": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "tranche": { "type": "integer" },
              "pct": { "type": "number" },
              "condition": { "type": "string" }
            }
          }
        },
        "exit_plan": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "trigger": { "type": "string" },
              "action": { "type": "string" }
            }
          }
        },
        "price_zones": {
          "type": "object",
          "properties": {
            "buy_range": { "type": "array", "items": { "type": "number" }, "minItems": 2, "maxItems": 2 },
            "caution_range": { "type": "array", "items": { "type": "number" } },
            "sell_warning_above": { "type": "number" }
          }
        }
      }
    },

    "rationale": {
      "type": "array",
      "minItems": 3,
      "maxItems": 5,
      "description": "투자 결론의 이유 3~5개. 각 항목은 검증 가능한 출처를 가져야 한다.",
      "items": {
        "type": "object",
        "required": ["point", "evidence"],
        "properties": {
          "point": { "type": "string" },
          "evidence": {
            "type": "object",
            "required": ["source"],
            "properties": {
              "metric": { "type": "string" },
              "value": { "type": ["number", "string", "null"] },
              "source": {
                "type": "string",
                "description": "출처 ID. 예: 'dart:20260315000123', 'krx:flow:2026-08-05'"
              }
            }
          }
        }
      }
    },

    "assumptions": {
      "type": "array",
      "items": { "type": "string" },
      "description": "이것이 깨지면 결론이 바뀌는 전제. 리포트 생성 시 필수(비어 있으면 렌더링 실패)."
    },

    "risks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["risk", "impact", "monitor"],
        "properties": {
          "risk": { "type": "string" },
          "impact": { "type": "string" },
          "monitor": { "type": "string", "description": "이 리스크를 감시할 관측 지표" }
        }
      }
    },

    "patterns": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "pattern": "^(KP|ANTI)-[0-9]{2}$" },
          "name": { "type": "string" },
          "status": { "enum": ["가설", "검증중", "검증됨", "기각", "구조적차단"] },
          "matched": { "type": "boolean" },
          "priority_bonus": { "type": "number", "maximum": 5 }
        }
      }
    },

    "data_quality": {
      "type": "object",
      "properties": {
        "coverage_by_axis": {
          "type": "object",
          "additionalProperties": { "type": "number" }
        },
        "proxy_usage": {
          "type": "array",
          "items": { "type": "string" },
          "description": "프록시로 대체한 지표 목록 (예: 컨센서스 미확보 → 전년동기 외삽)"
        },
        "days_since_last_report": { "type": "integer" },
        "skipped_metrics": { "type": "array", "items": { "type": "string" } }
      }
    },

    "audit": {
      "type": "object",
      "description": "INV-4 감사추적. 이 정보로 신호를 100% 재현할 수 없으면 그 신호는 폐기한다.",
      "required": ["input_hash"],
      "properties": {
        "input_hash": { "type": "string" },
        "feature_snapshot_ref": { "type": "string" },
        "trial_id": { "type": ["string", "null"] }
      }
    },

    "disclaimer": {
      "type": "string",
      "description": "리서치 보조 자료이며 투자 자문이 아님을 명시하는 고정 문구."
    }
  }
}
